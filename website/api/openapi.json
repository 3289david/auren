{
  "openapi": "3.0.3",
  "info": {
    "title": "AUREN node API",
    "version": "0.6",
    "description": "Every AUREN node serves this API on its RPC port (default 9650). Reads are plain REST. Everything, including sending transactions, is also available over JSON-RPC 2.0 at POST /rpc. Ethereum tools can use the same /rpc endpoint (eth_* methods; chain IDs 77000 mainnet, 77001 devnet, 77002 testnet). Amounts are decimal strings in sparks (1 AUR = 1,000,000,000 sparks). See docs/integrate.md.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9650",
      "description": "A node on this computer"
    }
  ],
  "tags": [
    {
      "name": "Read"
    },
    {
      "name": "Write"
    },
    {
      "name": "JSON-RPC"
    }
  ],
