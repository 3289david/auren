# Public addresses of the three official networks. One node serves each network; Caddy adds HTTPS.
# Each network answers on two names (a mirror pair). Caddy gets and renews the certificates by itself.
# Ports on the server: devnet node 9650 (faucet 9690), testnet node 9660 (faucet 9691), mainnet node 9670.

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

devnet.auren.im, devnet.krl.kr {
	import common
	handle_path /faucet/* {
		reverse_proxy 127.0.0.1:9690
	}
	reverse_proxy 127.0.0.1:9650
}

testnet.auren.im, testnet.krl.kr {
	import common
	handle_path /faucet/* {
		reverse_proxy 127.0.0.1:9691
	}
	reverse_proxy 127.0.0.1:9660
}

mainnet.auren.im, mainnet.krl.kr {
	import common
	reverse_proxy 127.0.0.1:9670
}
